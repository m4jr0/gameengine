{
  "rasterizer": {
    "is_wireframe": false,
    "is_depth_bias": false,
    "cull_mode": "none"
  },
  "depth_stencil": {
    "is_depth_test": true,
    "is_depth_write": true,
    "compare_op": "less"
  },
  "shader_module_paths": [
    "shaders/vulkan/forward.vk.vert",
    "shaders/vulkan/forward.vk.frag"
  ],
  "vertex_layout": "skinned_vertex",
  "bindings": [
    {
      "name": "FrameGlobals",
      "type": "uniform_buffer",
      "scope": "global",
      "layout": "std140",
      "set": 0,
      "binding": 0,
      "stages": [
        "vertex",
        "fragment"
      ],
      "fields": [
        {
          "name": "projection",
          "type": "mat4"
        },
        {
          "name": "view",
          "type": "mat4"
        },
        {
          "name": "ambientColor",
          "type": "vec4"
        },
        {
          "name": "viewPos",
          "type": "vec4"
        }
      ]
    },
    {
      "name": "ShadowMaps",
      "type": "combined_image_sampler",
      "scope": "global",
      "set": 0,
      "binding": 1,
      "descriptor_count": 1,
      "stages": [
        "fragment"
      ],
      "fields": []
    },
    {
      "name": "ShadowSettings",
      "type": "uniform_buffer",
      "scope": "global",
      "layout": "std140",
      "set": 0,
      "binding": 2,
      "stages": [
        "fragment"
      ],
      "fields": [
        {
          "name": "params0",
          "type": "vec4"
        },
        {
          "name": "params1",
          "type": "svec4"
        }
      ]
    },
    {
      "name": "MaterialParams",
      "type": "uniform_buffer",
      "scope": "material",
      "layout": "std140",
      "set": 1,
      "binding": 0,
      "stages": [
        "fragment"
      ],
      "fields": [
        {
          "name": "diffuseColor",
          "type": "vec4"
        },
        {
          "name": "shininess",
          "type": "f32"
        }
      ]
    },
    {
      "name": "MaterialTextures",
      "type": "combined_image_sampler",
      "scope": "material",
      "set": 1,
      "binding": 1,
      "descriptor_count": 3,
      "image_semantic": "material_textures",
      "stages": [
        "fragment"
      ],
      "fields": []
    },
    {
      "name": "ProxyLocalDatas",
      "type": "storage_buffer",
      "scope": "pass",
      "layout": "std430",
      "set": 2,
      "binding": 0,
      "stages": [
        "vertex"
      ],
      "fields": [
        {
          "name": "localCenter",
          "type": "vec4"
        },
        {
          "name": "localMaxExtents",
          "type": "vec4"
        },
        {
          "name": "transform",
          "type": "mat4"
        },
        {
          "name": "skinningOffset",
          "type": "u32"
        }
      ]
    },
    {
      "name": "ProxyIds",
      "type": "storage_buffer",
      "scope": "pass",
      "layout": "std430",
      "set": 2,
      "binding": 1,
      "stages": [
        "vertex"
      ],
      "fields": [
        {
          "name": "proxyId",
          "type": "u32"
        }
      ]
    },
    {
      "name": "MatrixPalettes",
      "type": "storage_buffer",
      "scope": "pass",
      "layout": "std430",
      "set": 2,
      "binding": 7,
      "stages": [
        "vertex"
      ],
      "fields": [
        {
          "name": "skinningMatrix",
          "type": "mat4"
        }
      ]
    },
    {
      "name": "Lights",
      "type": "storage_buffer",
      "scope": "pass",
      "layout": "std430",
      "set": 2,
      "binding": 8,
      "stages": [
        "fragment"
      ],
      "fields": [
        {
          "name": "positionType",
          "type": "vec4"
        },
        {
          "name": "directionIntensity",
          "type": "vec4"
        },
        {
          "name": "colorRange",
          "type": "vec4"
        },
        {
          "name": "shadowHeader",
          "type": "vec4"
        },
        {
          "name": "spotData",
          "type": "vec4"
        }
      ]
    },
    {
      "name": "Shadows",
      "type": "storage_buffer",
      "scope": "pass",
      "layout": "std430",
      "set": 2,
      "binding": 9,
      "stages": [
        "fragment"
      ],
      "fields": [
        {
          "name": "viewProj",
          "type": "mat4"
        },
        {
          "name": "cascadeData",
          "type": "vec4"
        },
        {
          "name": "biasData",
          "type": "vec4"
        }
      ]
    }
  ],
  "push_constants": [
    {
      "name": "FragmentLightingPushConstants",
      "stages": [
        "fragment"
      ],
      "fields": [
        {
          "name": "lightCount",
          "type": "u32"
        }
      ]
    }
  ]
}