#ifndef LOCAL_SIZE
#define LOCAL_SIZE 256
#endif  // LOCAL_SIZE

#ifdef COMET_VALIDATION_DEBUG_PRINTF_EXT
#extension GL_EXT_debug_printf : enable
#endif  // COMET_VALIDATION_DEBUG_PRINTF_EXT

struct ProxyLocalData {
  vec4 localCenter;
  vec4 localMaxExtents;
  mat4 transform;
  uint skinningOffset;
};

struct ProxyInstance {
  uint proxyId;
  uint batchId;
};

struct IndirectProxy {
  uint indexCount;
  uint instanceCount;
  uint firstIndex;
  int vertexOffset;
  uint firstInstance;
  uint proxyId;
  uint batchId;
};

struct CameraData {
  mat4 projection;
  mat4 view;
  vec4 viewPos;
};

#ifdef COMET_DEBUG_RENDERING
struct DebugAabb {
  vec4 minExtents;
  vec4 maxExtents;
};

struct DebugData {
  uint visibleCount;
};
#endif  // COMET_DEBUG_RENDERING

layout(local_size_x = LOCAL_SIZE) in;

layout(push_constant) uniform Constants {
  uint drawCount;
  uint cameraIndex;
}
constants;

layout(std430, set = 2, binding = 0) readonly buffer InProxyLocalDatasSsbo {
  ProxyLocalData inProxyLocalDatas[];
};

layout(std430, set = 2, binding = 1) buffer OutProxyIdsSsbo {
  uint outProxyIds[];
};

layout(std430, set = 2, binding = 2) readonly buffer InProxyInstancesSsbo {
  ProxyInstance inProxyInstances[];
};

layout(std430, set = 2, binding = 3) buffer InIndirectProxiesSsbo {
  IndirectProxy inIndirectProxies[];
};

#ifdef COMET_DEBUG_RENDERING
layout(std430, set = 2, binding = 4) buffer OutDebugDataSsbo {
  DebugData outDebugData;
};

layout(std430, set = 2, binding = 5) buffer OutDebugAabbSsbo {
  DebugAabb outDebugAabbs[];
};
#endif  // COMET_DEBUG_RENDERING

layout(std430, set = 2, binding = 10) readonly buffer CameraDatasSsbo {
  CameraData cameraDatas[];
};

shared vec4 sharedFrustumPlanes[6];

vec4 generatePlaneFromPoints(vec3 a, vec3 b, vec3 c) {
  vec3 normal = normalize(cross(b - a, c - a));
  float d = -dot(normal, a);
  return vec4(normal, d);
}

void generateFrustumPlanes(mat4 viewProjInverse) {
  vec3 ndcCorners[8] =
      vec3[](vec3(-1.0, -1.0, -1.0), vec3(1.0, -1.0, -1.0),
             vec3(1.0, 1.0, -1.0), vec3(-1.0, 1.0, -1.0), vec3(-1.0, -1.0, 1.0),
             vec3(1.0, -1.0, 1.0), vec3(1.0, 1.0, 1.0), vec3(-1.0, 1.0, 1.0));

  vec3 worldCorners[8];

  for (int i = 0; i < 8; ++i) {
    vec4 world = viewProjInverse * vec4(ndcCorners[i], 1.0);
    worldCorners[i] = world.xyz / world.w;
  }

  sharedFrustumPlanes[0] = generatePlaneFromPoints(
      worldCorners[0], worldCorners[1], worldCorners[2]);  // Near
  sharedFrustumPlanes[1] = generatePlaneFromPoints(
      worldCorners[4], worldCorners[7], worldCorners[6]);  // Far
  sharedFrustumPlanes[2] = generatePlaneFromPoints(
      worldCorners[0], worldCorners[3], worldCorners[7]);  // Left
  sharedFrustumPlanes[3] = generatePlaneFromPoints(
      worldCorners[1], worldCorners[5], worldCorners[6]);  // Right
  sharedFrustumPlanes[4] = generatePlaneFromPoints(
      worldCorners[3], worldCorners[2], worldCorners[6]);  // Top
  sharedFrustumPlanes[5] = generatePlaneFromPoints(
      worldCorners[0], worldCorners[4], worldCorners[1]);  // Bottom
}

bool isAabbInOrOnPlane(vec4 plane, vec3 center, vec3 extents) {
  float radius = dot(extents, abs(plane.xyz));
  float signedDistance = dot(plane.xyz, center) + plane.w;
  return signedDistance >= -radius;
}

void generateWorldAabb(vec3 localCenter, vec3 localExtents, mat4 transform,
                       out vec3 outCenter, out vec3 outExtents) {
  vec3 localMin = localCenter - localExtents;
  vec3 localMax = localCenter + localExtents;

  mat3 basis = mat3(transform);
  vec3 worldMin = vec3(0.0);
  vec3 worldMax = vec3(0.0);

  for (int axis = 0; axis < 3; ++axis) {
    for (int component = 0; component < 3; ++component) {
      float a = basis[component][axis] * localMin[component];
      float b = basis[component][axis] * localMax[component];

      if (a < b) {
        worldMin[axis] += a;
        worldMax[axis] += b;
      } else {
        worldMin[axis] += b;
        worldMax[axis] += a;
      }
    }
  }

  vec3 translation = transform[3].xyz;
  worldMin += translation;
  worldMax += translation;

  outCenter = 0.5 * (worldMin + worldMax);
  outExtents = worldMax - outCenter;
}

bool IsWorldAabbVisible(vec3 center, vec3 extents) {
  for (int i = 0; i < 6; ++i) {
    if (!isAabbInOrOnPlane(sharedFrustumPlanes[i], center, extents)) {
      return false;
    }
  }

  return true;
}

void main() {
  uint drawIndex = gl_GlobalInvocationID.x;

  if (drawIndex >= constants.drawCount) {
    return;
  }

  if (gl_LocalInvocationIndex == 0) {
    CameraData camera = cameraDatas[constants.cameraIndex];
    mat4 viewProj = camera.projection * camera.view;
    mat4 viewProjInverse = inverse(viewProj);
    generateFrustumPlanes(viewProjInverse);
  }

  barrier();

  uint proxyId = inProxyInstances[drawIndex].proxyId;
  ProxyLocalData proxyData = inProxyLocalDatas[proxyId];

  vec3 center;
  vec3 extents;
  generateWorldAabb(proxyData.localCenter.xyz, proxyData.localMaxExtents.xyz,
                    proxyData.transform, center, extents);

#ifdef COMET_DEBUG_RENDERING
  outDebugAabbs[proxyId].minExtents = vec4(center - extents, 0.0);
  outDebugAabbs[proxyId].maxExtents = vec4(center + extents, 0.0);
#endif  // COMET_DEBUG_RENDERING

  if (!IsWorldAabbVisible(center, extents)) {
    return;
  }

#ifdef COMET_DEBUG_RENDERING
  atomicAdd(outDebugData.visibleCount, 1u);
#endif  // COMET_DEBUG_RENDERING

  uint batchId = inProxyInstances[drawIndex].batchId;
  uint visibleIndexInBatch =
      atomicAdd(inIndirectProxies[batchId].instanceCount, 1u);
  uint instanceIndex =
      inIndirectProxies[batchId].firstInstance + visibleIndexInBatch;

  outProxyIds[instanceIndex] = proxyId;
}