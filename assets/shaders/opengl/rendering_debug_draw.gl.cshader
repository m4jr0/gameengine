{
  "rasterizer": {
    "is_wireframe": true,
    "is_depth_bias": false,
    "cull_mode": "none"
  },
  "depth_stencil": {
    "is_depth_test": false,
    "is_depth_write": false,
    "compare_op": "always"
  },
  "topology": "lines",
  "shader_module_paths": [
    "shaders/opengl/rendering_debug.gl.vert",
    "shaders/opengl/rendering_debug.gl.frag"
  ],
  "vertex_layout": "debug_line",
  "bindings": [
    {
      "name": "CameraDatas",
      "type": "storage_buffer",
      "scope": "pass",
      "layout": "std430",
      "set": 2,
      "binding": 10,
      "stages": [
        "vertex"
      ],
      "fields": [
        {
          "name": "projection",
          "type": "mat4"
        },
        {
          "name": "view",
          "type": "mat4"
        },
        {
          "name": "viewPos",
          "type": "vec4"
        }
      ]
    },
    {
      "name": "DebugCameraFrustums",
      "type": "storage_buffer",
      "scope": "pass",
      "layout": "std430",
      "set": 2,
      "binding": 11,
      "stages": [
        "vertex"
      ],
      "fields": [
        {
          "name": "viewProj",
          "type": "mat4"
        }
      ]
    }
  ],
  "push_constants": [
    {
      "name": "DebugPushConstants",
      "stages": [
        "vertex"
      ],
      "fields": [
        {
          "name": "cameraFrustumVertexOffset",
          "type": "u32"
        },
        {
          "name": "cascadeFrustumVertexOffset",
          "type": "u32"
        },
        {
          "name": "lightFrustumVertexOffset",
          "type": "u32"
        },
        {
          "name": "cameraIndex",
          "type": "u32"
        },
        {
          "name": "debugDrawFlags",
          "type": "u32"
        }
      ]
    }
  ]
}