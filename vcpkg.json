{
  "name": "comet-game-engine",
  "version": "0.0.1",
  "description": "Simple video game engine",
  "homepage": "https://github.com/m4jr0/gameengine/",
  "builtin-baseline": "4b77da7fed37817f124936239197833469f1b9a8",
  "dependencies": [
    {
      "name": "assimp"
    },
    {
      "name": "detours",
      "platform": "windows"
    },
    {
      "name": "glm"
    },
    {
      "name": "nlohmann-json"
    },
    {
      "name": "picosha2"
    },
    {
      "name": "stb"
    },
    {
      "name": "lz4"
    },
    {
      "name": "shaderc"
    }
  ],
  "features": {
    "engine": {
      "description": "Full Comet engine graphics and window backends",
      "dependencies": [
        {
          "name": "glad"
        },
        {
          "name": "glfw3",
          "platform": "windows"
        },
        {
          "name": "glfw3",
          "features": [
            "wayland"
          ],
          "platform": "linux"
        },
        {
          "name": "imgui",
          "features": [
            "glfw-binding",
            "opengl3-binding",
            "vulkan-binding"
          ]
        },
        {
          "name": "opengl"
        },
        {
          "name": "vulkan"
        },
        {
          "name": "vulkan-memory-allocator"
        },
        {
          "name": "zlib"
        }
      ]
    },
    "tests": {
      "description": "Comet test dependencies",
      "dependencies": [
        {
          "name": "catch2"
        }
      ]
    }
  },
  "default-features": [
    "engine",
    "tests"
  ]
}
