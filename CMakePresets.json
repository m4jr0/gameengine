    {
      "name": "windows-base",
      "displayName": "Windows Base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "v145",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "VCPKG_ROOT": "${sourceDir}/.vcpkg",
        "IS_VCPKG_CLONE": "TRUE",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
